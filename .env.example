# ---- Server ----
PORT=8085
# NODE_ENV=production            # switches request logging to the 'combined' format
# CORS_ORIGIN=https://admin.example.com,https://app.example.com   # comma separated; unset = allow any origin
# BODY_LIMIT=500kb               # max JSON / form body size

# ---- PostgreSQL ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=tailorresume_auth
# PG_POOL_MAX=20
# PG_CONNECT_TIMEOUT_MS=5000

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secret_key
# JWT_ADMIN_SECRET=              # defaults to JWT_SECRET (dashboard tokens)
# JWT_USER_SECRET=               # defaults to JWT_SECRET (client app tokens)
# JWT_EXPIRES_IN=24h
# BCRYPT_SALT_ROUNDS=10

# ---- Local model gateway used by POST /api/gpt/responses ----
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama

# ---- Optional startup password prompt (interactive consoles only) ----
# STARTUP_AUTH_ENABLED=true
# STARTUP_PASSWORD=
# STARTUP_PASSWORD_HASHED=false
# STARTUP_MAX_ATTEMPTS=3
